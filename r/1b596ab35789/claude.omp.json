{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": false,
  "palette": {
    "frame": "#21c7c7",
    "white": "#ffffff",
    "ink": "#011627",
    "dim": "#9aa5ab",
    "pill": "#303030",
    "track": "#6b6b6b",
    "blue": "#0077c2",
    "orange": "#FF9248",
    "yellow": "#FFFB38",
    "paleyellow": "#ffeb95",
    "green": "#c5e478",
    "red": "#ef5350",
    "violet": "#C792EA",
    "purple": "#83769c",
    "cyan": "#40c4ff",
    "grey": "#b2bec3",
    "navy": "#306998",
    "gold": "#FFE873",
    "slate": "#1e293b",
    "royal": "#316ce4",
    "as1": "#2b2440",
    "as2": "#3a3156",
    "as3": "#4a3f6b",
    "astext": "#d9d3e8"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "<p:frame,transparent>╭─</>",
          "trailing_diamond": "",
          "foreground": "p:astext",
          "background": "p:as1",
          "template": " Auto"
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:astext",
          "background": "p:as2",
          "template": "Settings"
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:astext",
          "background": "p:as3",
          "template": ".win "
        },
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "p:white",
          "background": "p:blue",
          "template": "󰯉 {{ replace \" (1M context)\" \"\" .Model.DisplayName }}{{ if gt .ContextWindow.ContextWindowSize 200000 }}  1M{{ end }}{{ if .FastMode }}  fast{{ end }} "
        },
        {
          "type": "claude",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:ink",
          "background": "p:green",
          "background_templates": [
            "{{ if ge .TokenUsagePercent 80 }}p:red{{ end }}",
            "{{ if ge .TokenUsagePercent 50 }}p:paleyellow{{ end }}"
          ],
          "options": {
            "gauge_marked_char": "▰",
            "gauge_unmarked_char": "▱"
          },
          "template": " {{ $n := div (int .TokenUsagePercent) 10 }}{{ repeat (int $n) \"▰\" }}<p:white>{{ repeat (int (sub 10 $n)) \"▰\" }}</> {{ .TokenUsagePercent }}% {{ if ge .TokenUsagePercent 90 }}󰂃{{ else if ge .TokenUsagePercent 70 }}󰁻{{ else if ge .TokenUsagePercent 50 }}󰁽{{ else if ge .TokenUsagePercent 30 }}󰁿{{ else if ge .TokenUsagePercent 10 }}󰂁{{ else }}󰁹{{ end }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:ink",
          "background": "p:orange",
          "options": {
            "style": "folder"
          },
          "template": "{{ if lt (int .Env.CL_L1) 4 }}  {{ .Path }} {{ end }}"
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:ink",
          "background": "p:yellow",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:paleyellow{{ end }}"
          ],
          "options": {
            "fetch_status": true,
            "branch_icon": " "
          },
          "template": "{{ if lt (int .Env.CL_L1) 5 }} {{ .HEAD }}{{ if .Staging.Changed }} +{{ add .Staging.Added .Staging.Modified .Staging.Deleted .Staging.Unmerged }}{{ end }}{{ if .Working.Changed }} ~{{ add .Working.Added .Working.Modified .Working.Deleted .Working.Unmerged .Working.Untracked }}{{ end }} {{ end }}"
        },
        {
          "type": "claude",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:ink",
          "background": "p:violet",
          "template": "{{ if lt (int .Env.CL_L1) 4 }}{{ if .Worktree }}  {{ .Worktree.Name }} {{ else if .Workspace.GitWorktree }}  {{ .Workspace.GitWorktree }} {{ end }}{{ end }}"
        },
        {
          "type": "claude",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:white",
          "background": "p:purple",
          "template": "{{ if and .Agent (lt (int .Env.CL_L1) 4) }} 󰚩 {{ .Agent.Name }} {{ end }}"
        },
        {
          "type": "claude",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:ink",
          "background": "p:cyan",
          "template": "{{ if and .SessionName (lt (int .Env.CL_L1) 3) }}  {{ .SessionName }} {{ end }}"
        },
        {
          "type": "claude",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:ink",
          "background": "p:grey",
          "template": "{{ if and .OutputStyle (lt (int .Env.CL_L1) 2) }}{{ if ne (lower .OutputStyle.Name) \"default\" }}  {{ .OutputStyle.Name }} {{ end }}{{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame",
          "template": "╰─"
        },
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "foreground": "p:white",
          "background": "p:pill",
          "template": " {{ .FormattedTokens }}{{ if lt (int .Env.CL_L2) 2 }} <p:dim>↑</>{{ div .ContextWindow.TotalInputTokens 1000 }}k <p:dim>↓</>{{ div .ContextWindow.TotalOutputTokens 1000 }}k{{ end }}"
        },
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if ge .Cost.TotalCostUSD 1.0 }}p:red{{ end }}",
            "{{ if ge .Cost.TotalCostUSD 0.3 }}p:yellow{{ end }}"
          ],
          "background": "p:pill",
          "template": "{{ if and (gt .Cost.TotalCostUSD 0.0) (lt (int .Env.CL_L2) 5) }} {{ printf \"%.2f\" .Cost.TotalCostUSD }}{{ end }}"
        },
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if ge .FiveHourUsage 80 }}p:red{{ end }}",
            "{{ if ge .FiveHourUsage 50 }}p:yellow{{ end }}"
          ],
          "background": "p:pill",
          "template": "{{ if and .RateLimits .RateLimits.FiveHour }}{{ .Env.CL_5H_LABEL }} {{ if lt (int .Env.CL_L2) 3 }}{{ $n := div (int .FiveHourUsage) 20 }}{{ repeat (int $n) \"▰\" }}<p:track>{{ repeat (int (sub 5 $n)) \"▰\" }}</> {{ end }}{{ if .Env.CL_5H_PCT }}{{ .Env.CL_5H_PCT }}{{ else }}{{ .FiveHourUsage }}{{ end }}%{{ if .Env.CL_5H_IN }}<p:dim> ·{{ .Env.CL_5H_IN }}</>{{ end }}{{ end }}"
        },
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if ge .SevenDayUsage 80 }}p:red{{ end }}",
            "{{ if ge .SevenDayUsage 50 }}p:yellow{{ end }}"
          ],
          "background": "p:pill",
          "template": "{{ if and .RateLimits .RateLimits.SevenDay }}{{ .Env.CL_7D_LABEL }} {{ if lt (int .Env.CL_L2) 3 }}{{ $n := div (int .SevenDayUsage) 20 }}{{ repeat (int $n) \"▰\" }}<p:track>{{ repeat (int (sub 5 $n)) \"▰\" }}</> {{ end }}{{ if .Env.CL_7D_PCT }}{{ .Env.CL_7D_PCT }}{{ else }}{{ .SevenDayUsage }}{{ end }}%{{ if .Env.CL_7D_IN }}<p:dim> ·{{ .Env.CL_7D_IN }}</>{{ end }}{{ end }}"
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "foreground": "p:gold",
          "foreground_templates": [
            "{{ if eq .Env.CL_SUB_LVL \"crit\" }}p:white{{ end }}"
          ],
          "background": "p:navy",
          "background_templates": [
            "{{ if eq .Env.CL_SUB_LVL \"crit\" }}p:red{{ end }}",
            "{{ if eq .Env.CL_SUB_LVL \"warn\" }}p:orange{{ end }}"
          ],
          "template": "{{ if and .Env.CL_SUB (lt (int .Env.CL_L2) 4) }} {{ .Env.CL_SUB }} ·{{ .Env.CL_SUB_DAYS }}{{ .Env.CL_SUB_UNIT }}{{ end }}"
        },
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "foreground": "p:white",
          "foreground_templates": [
            "{{ if and .PR (eq .PR.ReviewState \"approved\") }}p:green{{ end }}",
            "{{ if and .PR (eq .PR.ReviewState \"changes_requested\") }}p:red{{ end }}",
            "{{ if and .PR (eq .PR.ReviewState \"pending\") }}p:yellow{{ end }}",
            "{{ if and .PR (eq .PR.ReviewState \"draft\") }}p:dim{{ end }}"
          ],
          "background": "p:slate",
          "template": "{{ if and .PR (lt (int .Env.CL_L2) 4) }}{{ if .PR.Number }} {{ if .PR.URL }}{{ url (printf \"#%s\" .PR.Number) .PR.URL }}{{ else }}#{{ .PR.Number }}{{ end }}{{ if eq .PR.ReviewState \"approved\" }} appr{{ else if eq .PR.ReviewState \"changes_requested\" }} chg{{ else if eq .PR.ReviewState \"pending\" }} pend{{ else if eq .PR.ReviewState \"draft\" }} draft{{ end }}{{ end }}{{ end }}"
        },
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "foreground": "p:white",
          "background": "p:purple",
          "template": "{{ if lt (int .Env.CL_L2) 3 }}{{ if .Effort }} {{ .Effort.Level }}{{ if and .Thinking .Thinking.Enabled }} ·think{{ end }}{{ else if and .Thinking .Thinking.Enabled }} think{{ end }}{{ end }}"
        },
        {
          "type": "claude",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "foreground": "p:white",
          "background": "p:pill",
          "template": "{{ if and (or .Cost.TotalLinesAdded .Cost.TotalLinesRemoved) (lt (int .Env.CL_L2) 2) }}<p:green>+{{ .Cost.TotalLinesAdded }}</> <p:red>-{{ .Cost.TotalLinesRemoved }}</>{{ end }}"
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "foreground": "p:white",
          "background": "p:royal",
          "template": "{{ if and .Env.CL_CACHE (lt (int .Env.CL_L2) 1) }} {{ .Env.CL_CACHE }}{{ end }}"
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "p:ink",
          "background": "p:cyan",
          "template": "{{ if and .Env.CL_DUR (lt (int .Env.CL_L2) 1) }} {{ .Env.CL_DUR }}{{ end }}"
        }
      ]
    }
  ]
}
